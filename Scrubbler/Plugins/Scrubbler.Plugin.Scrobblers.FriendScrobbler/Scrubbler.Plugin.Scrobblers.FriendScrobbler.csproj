<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <!-- A single target avoids cross-targeting restore edges in the monorepo graph. -->
    <TargetFramework>net10.0</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Optional but recommended -->
    <UseUnoXaml>true</UseUnoXaml>
    <EnableDefaultXamlItems>true</EnableDefaultXamlItems>

    <!-- This helps IDEs know it's a Uno/WinUI library -->
    <OutputType>Library</OutputType>

    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0</FileVersion>
  </PropertyGroup>

  <!-- Remove autogenerated item duplication -->
  <ItemGroup>
    <None Remove="FriendScrobbleView.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- External dependencies -->
    <PackageReference Include="Shoegaze.LastFM" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scrubbler.PluginBase\Scrubbler.PluginBase.csproj" />
  </ItemGroup>

  <!-- Uno.Sdk already handles XAML codegen, but explicit Page is fine -->
  <ItemGroup>
    <Page Include="FriendScrobbleView.xaml">
      <Generator>MSBuild:Compile</Generator>
    </Page>
  </ItemGroup>

  <!-- Environment file -->
  <ItemGroup>
    <None Update="environment.env">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Include="icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
